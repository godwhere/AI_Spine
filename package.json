{
  "name": "ispine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prepare-sites-build.mjs",
    "preview": "vite preview",
    "test": "node --test tests/*.test.mjs",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "test:egg": "node --test tests/egg-character.test.mjs",
    "workbench": "node scripts/start-workbench.mjs --open",
    "test:workspace": "node --test tests/workspace.test.mjs tests/project-index.test.mjs tests/workspace-v2.test.mjs tests/workspace-v2-http.test.mjs tests/workspace-v2-client.test.mjs tests/workspace-v2-composition.test.mjs tests/workspace-migration.test.mjs",
    "test:architecture": "node --test tests/architecture.test.mjs",
    "test:isolation": "node --test tests/isolation.test.mjs",
    "test:e2e": "playwright test",
    "test:performance": "node scripts/measure-workspace.mjs && node scripts/measure-workspace-v2.mjs",
    "baseline:architecture": "node scripts/architecture-baseline.mjs",
    "preview:isolated": "node scripts/preview-isolated.mjs",
    "test:engine": "node --test tests/engine.test.mjs",
    "test:backend": "node --test tests/backend.test.mjs tests/bootstrap.test.mjs tests/workspace.test.mjs",
    "index:workspace": "node scripts/workspace-index.mjs",
    "migrate:workspace": "node scripts/migrate-workspace.mjs"
  },
  "dependencies": {
    "@esotericsoftware/spine-core": "4.3.13",
    "@esotericsoftware/spine-webgl": "4.3.13",
    "@vitejs/plugin-react": "5.0.4",
    "fflate": "0.8.2",
    "lucide-react": "0.468.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "vite": "6.4.2"
  },
  "devDependencies": {
    "@babel/parser": "7.29.9",
    "@babel/traverse": "7.29.10",
    "@napi-rs/canvas": "0.1.80",
    "@playwright/test": "1.64.1",
    "fake-indexeddb": "6.2.6"
  }
}
