  "jobs": [
    {
      "id": "1da040d5-5cc9-48df-9474-8de59dccffa0",
      "status": "cancelled",
      "requested": 49,
      "completed": 12,
      "concurrency": 1,
      "prompt": "制作原创齐天大圣悟空猴王，严格以已导入的金甲猴王形象为统一风格参考。把熊猫的所有部件重新设计为猴子对应部件：金棕色猴毛、桃棕色裸露猴指与脚趾，头部是明确的猴脸、桃色口鼻、圆猴耳、金色紧箍、琥珀眼，去除熊猫黑眼圈和黑白毛。头发和马尾为金色毛发红绳束发。躯干和肩臂均为金棕猴毛，护腕和护甲为红漆与古金云纹，丝绸腰带为朱红配金边，项链为红金装饰珠片。尾巴为连续金棕色长猴尾，无黑白环纹。保持每个输入部件原有的精确形状、方向、比例、接缝、关节位置和透明留白，不要把完整形象复制到部件内。F_ 部件是相同角色的另一个朝向，保持参考的视角。head 只画头部，不要画马尾或躯干；F_head 按其原有后脑视角绘制，不额外添正面脸；jaw/cheek/mouth 只绘制原来对应的面部碎片。手指部件只画单独指块，不画整只手。所有纹理均为手绘游戏风格，统一光照、饱和度与描边。唯一 shadow 区域保持原来的扁椭圆形透明柔和落地影，改为深暖褐色。其余部件不添加投影或背景。不添加金箍棒、武器、文字或额外肢体，不改变模板骨架。",
      "createdAt": "2026-10-19T14:50:47.490Z",
      "updatedAt": "2026-10-19T15:02:08.940Z"
    },
